{
  "name": "analizador-de-comics",
  "version": "0.1.3",
  "description": "Tracker local de comics de Spider-Man y lineas relacionadas, con SQLite, UI y revision por Telegram.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "server:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/server-start.ps1",
    "server:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/server-stop.ps1",
    "server:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/server-status.ps1",
    "import:catalog": "node scripts/import-spiderman-catalog.js",
    "repair:covers": "node scripts/repair-catalog-covers.js",
    "repair:enemies": "node scripts/backfill-catalog-enemies.js",
    "repair:spanish-covers": "node scripts/repair-spanish-covers.js",
    "repair:dates": "node scripts/repair-catalog-dates.js",
    "repair:appearances": "node scripts/repair-appearance-details.js",
    "test": "node --test tests/*.test.js && python -B tests/telegram_bot_test.py",
    "test:security": "node --test --experimental-test-coverage --test-coverage-include=src/http-security.js --test-coverage-include=src/server.js --test-coverage-include=public/local-api.js --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 tests/http-security.test.js tests/server.test.js tests/ui-security.test.js",
    "test:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/process-tree.test.ps1",
    "test:python-coverage": "python -B -m coverage run --branch --data-file=data/coverage/python.coverage --include=src/telegram_bot.py tests/telegram_bot_test.py && python -B -m coverage report --data-file=data/coverage/python.coverage --fail-under=100",
    "test:shutdown": "node --test --experimental-test-coverage --test-coverage-include=src/weekly-shutdown.js --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 tests/weekly-shutdown.test.js",
    "test:coverage": "node tests/run-coverage.js",
    "test:coverage:node": "node tests/run-node-coverage.js",
    "test:coverage:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/run-csharp-coverage.ps1 && powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/run-powershell-coverage.ps1 && node --test tests/native/wrappers.test.js",
    "test:posix": "node --test tests/native/posix.test.js",
    "test:full": "npm test && npm run test:windows && npm run test:coverage"
  },
  "license": "MIT",
  "devDependencies": {
    "jsdom": "30.1.3"
  }
}
