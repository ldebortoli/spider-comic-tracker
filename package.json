{
  "name": "analizador-de-comics",
  "version": "0.1.5",
  "description": "Tracker local de comics de Spider-Man y lineas relacionadas, con SQLite, UI y revision por Telegram.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "server:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/server-start.ps1",
    "server:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/server-stop.ps1",
    "server:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/server-status.ps1",
    "import:catalog": "node scripts/import-spiderman-catalog.js",
    "repair:covers": "node scripts/repair-catalog-covers.js",
    "repair:enemies": "node scripts/backfill-catalog-enemies.js",
    "repair:spanish-covers": "node scripts/repair-spanish-covers.js",
    "repair:dates": "node scripts/repair-catalog-dates.js",
    "repair:appearances": "node scripts/repair-appearance-details.js",
    "test": "node tests/run-isolated.cjs test",
    "test:security": "node tests/run-isolated.cjs security",
    "test:windows": "node tests/run-isolated.cjs windows",
    "test:python-coverage": "node tests/run-isolated.cjs python",
    "test:shutdown": "node tests/run-isolated.cjs shutdown",
    "test:coverage": "node tests/run-isolated.cjs coverage",
    "test:coverage:node": "node tests/run-isolated.cjs node",
    "test:coverage:native": "node tests/run-isolated.cjs native",
    "test:posix": "node tests/run-isolated.cjs posix",
    "test:full": "node tests/run-isolated.cjs full"
  },
  "license": "MIT",
  "devDependencies": {
    "jsdom": "30.1.3"
  }
}
